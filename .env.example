# AgTech MCP Server — Environment Variables
# Copy this file to .env and fill in the values you need.
# Tier 1 APIs work without any keys.

# === Tier 2: Free with registration ===

# USDA NASS QuickStats — https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# NOAA Climate Data Online — https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=

# Sentinel Hub (Copernicus) — https://dataspace.copernicus.eu/
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# NASA Earthdata (AppEEARS) — https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Pl@ntNet — https://my.plantnet.org/
PLANTNET_API_KEY=

# EPPO Data Portal — https://data.eppo.int/
EPPO_API_KEY=

# === Tier 3: Commercial / Limited ===

# Agromonitoring (OpenWeatherMap) — https://agromonitoring.com/
AGROMONITORING_API_KEY=

# Yandex Weather — https://developer.tech.yandex.ru/services/18
YANDEX_WEATHER_API_KEY=
